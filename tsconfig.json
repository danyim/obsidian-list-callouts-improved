{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "es2018", "scripthost"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "target": "es2018",
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types",
      "wdio-obsidian-service"
    ]
  },
  "include": ["./src/**/*.ts", "./test/**/*.ts"]
}
