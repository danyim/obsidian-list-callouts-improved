{
  "name": "callout-bullets",
  "version": "1.2.9",
  "description": "Create simple callouts in lists.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check-types": "tsc --noEmit",
    "icons": "node make-icon-list.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "clean": "npm run prettier && npm run lint:fix",
    "test": "npm run test:e2e",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "screenshots": "wdio run ./wdio.screenshots.mts",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && npm run rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "danyim",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/language": "https://github.com/lishid/cm-language#1aadcc247f20ccfda76424a9f853dbb4ee203fdc",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@wdio/cli": "^9.28.0",
    "@wdio/globals": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "@wdio/spec-reporter": "^9.28.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "lucide-static": "^1.41.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.13.1",
    "obsidian-launcher": "^3.1.1",
    "prettier": "^3.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "fuse.js": "^6.6.2"
  }
}
