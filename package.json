{
  "name": "obsidian-list-callouts-improved",
  "version": "1.6.1",
  "description": "Create simple callouts in lists.",
  "main": "main.js",
  "scripts": {
    "dev": "node config/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node config/esbuild.config.mjs production",
    "check-types": "tsc --noEmit",
    "icons": "node scripts/make-icon-list.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path config/.prettierignore --write \"./src/**/*.{ts,tsx}\"",
    "clean": "npm run prettier && npm run lint:fix",
    "swap": "node scripts/swap-installed-plugin.mjs",
    "pretest": "npm run build",
    "test": "npm run test:scripts && npm run test:e2e",
    "test:scripts": "node --test scripts/*.test.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "scripts/xvfb-wm.sh wdio run ./config/wdio.conf.mts",
    "prescreenshots": "npm run build",
    "screenshots": "scripts/xvfb-wm.sh wdio run ./config/wdio.screenshots.mts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push && git push --tags"
  },
  "keywords": [],
  "author": "danyim",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/language": "https://github.com/lishid/cm-language#1aadcc247f20ccfda76424a9f853dbb4ee203fdc",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@wdio/cli": "^9.28.0",
    "@wdio/globals": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "lucide-static": "^1.41.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0",
    "fuse.js": "^7.5.0"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "css",
    "bracketSameLine": false,
    "jsxSingleQuote": false,
    "printWidth": 80,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "importOrder": [
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
